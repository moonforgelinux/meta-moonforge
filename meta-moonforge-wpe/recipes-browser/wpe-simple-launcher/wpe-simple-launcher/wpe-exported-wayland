#!/bin/sh

# Disable sandboxing for WebKit (dangerous, use with caution)
# export WEBKIT_DISABLE_SANDBOX_THIS_IS_DANGEROUS=1

# Lower rank of AV1 decoder to disable it
export GST_PLUGIN_FEATURE_RANK="avdec_av1:0"

# Set directory for GStreamer debug output
# export GST_DEBUG_DUMP_DOT_DIR=/tmp/gst-out/
# mkdir -p /tmp/gst-out
# chmod 777 /tmp/gst-out

# FIFO path used for the wpe-simple-launcher --ctrl channel (see wpe-ctl)
CTL_FILE="/tmp/wpe-exported-wayland"

# Detect the board from the device-tree model rather than the hostname, which
# can be overridden per device. The model is a NUL-terminated string such as
# "Raspberry Pi 5 Model B Rev 1.0".
IS_RPI5=0
if [ -r /proc/device-tree/model ] && \
   tr -d '\0' < /proc/device-tree/model | grep -q "Raspberry Pi 5"; then
    IS_RPI5=1
fi

# Enable DMA-BUF video sink in WebKit for efficient rendering.
# WebKitDMABufVideoSink sink that is able to accept decode
# dmabuf or raw data in a range of RGB-like or YUV formats.
# Bug: https://bugs.webkit.org/show_bug.cgi?id=279819
#
# Apply workaround only if running on raspberrypi5
if [ "$IS_RPI5" -eq 1 ]; then
    export WEBKIT_GST_DMABUF_SINK_ENABLED=1
fi

# Regression in 2.48.X since
#   [GStreamer] Add support for DMA-BUF to GL video sink
#   https://bugs.webkit.org/show_bug.cgi?id=279672
# XXX Reported in : https://bugs.webkit.org/show_bug.cgi?id=288464
#
# Apply regression workaround only if running on raspberrypi5
if [ "$IS_RPI5" -eq 1 ]; then
    export WEBKIT_GST_DISABLE_GL_SINK=1
fi

# Ensure Wayland and XDG runtime environment variables are propagated.
# Keep only the first pid: busybox pidof has no -s (single shot) option.
WESTON_PID="$(pidof weston-keyboard 2>/dev/null || true)"
WESTON_PID="${WESTON_PID%% *}"

ENVIRON=""
if [ -n "$WESTON_PID" ]; then
    ENVIRON="$(tr '\0' '\n' < "/proc/$WESTON_PID/environ" 2>/dev/null || true)"
fi

if [ -n "$ENVIRON" ]; then
    WAYLAND_DISPLAY="$(printf '%s' "$ENVIRON" | grep -m1 '^WAYLAND_DISPLAY=')"
    XDG_RUNTIME_DIR="$(printf '%s' "$ENVIRON" | grep -m1 '^XDG_RUNTIME_DIR=')"
else
    for _dir in /tmp /run/user/0 "/run/user/$(id -u)"; do
        for _sock in wayland-0 wayland-1; do
            if [ -S "$_dir/$_sock" ]; then
                WAYLAND_DISPLAY="WAYLAND_DISPLAY=$_sock"
                XDG_RUNTIME_DIR="XDG_RUNTIME_DIR=$_dir"
                break 2
            fi
        done
    done
    if [ -z "$WAYLAND_DISPLAY" ]; then
        echo "wpe-exported-wayland: unable to find Wayland display" >&2
        exit 1
    fi
fi

export "${WAYLAND_DISPLAY:?wpe-exported-wayland: WAYLAND_DISPLAY not found in weston-keyboard environ}"
export "${XDG_RUNTIME_DIR:?wpe-exported-wayland: XDG_RUNTIME_DIR not found in weston-keyboard environ}"

# Check if the script is run as root and switch to the 'weston' user if needed
if [ "$(id -u)" -eq 0 ]; then
    # POSIX-safe quoting: wrap each arg in single quotes, escaping embedded ones
    ARGS=
    for arg in "$@"; do
        ARGS="$ARGS '$(printf '%s' "$arg" | sed "s/'/'\\\\''/g")'"
    done
    su weston -c "/usr/bin/wpe-simple-launcher --ctrl $CTL_FILE$ARGS"
else
    /usr/bin/wpe-simple-launcher --ctrl "$CTL_FILE" "$@"
fi
